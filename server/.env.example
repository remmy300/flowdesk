# PostgreSQL connection string (Neon, Supabase, or local).
DATABASE_URL="postgresql://user:password@host:5432/flowdesk?sslmode=require"

# Auth.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Google OAuth (https://console.cloud.google.com/apis/credentials).
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Client origins allowed by CORS (comma-separated).
CLIENT_URL="http://localhost:3002"
ALLOWED_ORIGINS="http://localhost:3002,http://localhost:3001"

# Server.
PORT=4000

# Cloudinary (optional; needed for avatar/file uploads).
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
