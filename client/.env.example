# Base URL of the FlowDesk API. The browser talks to this directly.
NEXT_PUBLIC_API_URL="http://localhost:4002/api"

# Clerk (https://dashboard.clerk.com -> API keys). Primary auth.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# Google OAuth client ID from Google Cloud Console. Legacy fallback login (optional).
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
